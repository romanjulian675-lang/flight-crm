# ---- Database ----
# Local default matches `npm run db:local` (embedded Postgres on port 5434).
DATABASE_URL="postgresql://flightcrm:flightcrm@localhost:5434/flightcrm"
# Used only by `npm test` (integration tests wipe this database).
TEST_DATABASE_URL="postgresql://flightcrm:flightcrm@localhost:5434/flightcrm_test"

# ---- Authentication (better-auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3200"

# ---- Secrets at rest ----
# Encrypts connected-account tokens (Facebook pages). 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-base64-32-bytes"

# ---- Public URL ----
# Where providers (Meta, Google, Zapier) reach the app. Must be public HTTPS in production.
APP_URL="http://localhost:3200"

# ---- Meta (Facebook / Instagram Lead Ads) ----
# From developers.facebook.com > your app. Leave empty to hide the Connect Facebook button.
META_APP_ID=""
META_APP_SECRET=""
# Any random string; paste the same value in the Meta app webhook settings.
META_VERIFY_TOKEN=""
META_GRAPH_VERSION="v23.0"

# ---- Scheduled Meta lead recovery ----
# Server-only random secret for GET /api/jobs/meta (Authorization: Bearer <secret>).
# Enable the scheduler only in production after migrations and smoke tests. See docs/meta-intake-operations.md.
CRON_SECRET=""

# ---- New-lead email alerts (Production only) ----
# Verify a dedicated sending subdomain with Resend. Enable recipients per school in Settings.
RESEND_API_KEY=""
LEAD_ALERT_FROM=""

# ---- Google Calendar ("Book a call" page) ----
# OAuth client (type "Web application") from console.cloud.google.com, with the Google Calendar API
# enabled and authorized redirect URI APP_URL/api/integrations/google/callback.
# Leave empty to hide the Connect Google Calendar button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Local preview/tests only: "1" swaps Google for a fake calendar (no network). Ignored in production.
CALENDAR_FAKE=""
